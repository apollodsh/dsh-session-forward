{
  "name": "dsh-session-forward",
  "version": "0.2.0",
  "description": "会话转发 · 把 DSH 里的一段对话交给别人：复制一条链接或导出一个零安装网页，对方不用装插件就能读；两边都装了插件时还能导入成可继续聊的真实会话。Share DSH conversations without making the recipient install anything.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/transcript.js",
    "lib/html.js",
    "lib/share.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "share",
    "handoff",
    "export",
    "import",
    "conversation-share"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apollodsh/dsh-session-forward.git"
  },
  "homepage": "https://github.com/apollodsh/dsh-session-forward#readme",
  "bugs": {
    "url": "https://github.com/apollodsh/dsh-session-forward/issues"
  },
  "author": "apollodsh",
  "scripts": {
    "test": "bash scripts/test.sh"
  }
}
